APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local app (php artisan serve on host) with Docker MySQL on port 3306:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=checkout_platform
# DB_USERNAME=checkout
# DB_PASSWORD=secret
#
# SQLite (no Docker):
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO=

# Mailjet transactional email (production)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_DEFAULT_PROVIDER=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# T-shirt landing pages (global wildcard domain)
TSHIRT_LANDING_DOMAIN=
TSHIRT_LANDING_USE_HTTPS=true

FULFILLMENT_DEFAULT_DELAY_DAYS=10
FULFILLMENT_QUEUE=default
FULFILLMENT_SCHEDULER_TIME=06:00
WAREHOUSE_API_BASE_URL=https://warehouse.example.com/api
WAREHOUSE_API_KEY=
WAREHOUSE_CREATE_SHIPMENT_PATH=/v1/shipments

SHIPSTATION_MODE=mock
SHIPSTATION_BASE_URL=https://api.shipstation.com/v2
SHIPSTATION_API_KEY=
SHIPSTATION_TIMEOUT=30
SHIPSTATION_QUEUE=
SHIPSTATION_WEBHOOK_SECRET=
SHIPSTATION_ORDER_KEY_PREFIX=cp-order-
SHIPSTATION_MOCK_BASE_URL=https://docs.shipstation.com/_mock/apis/openapi
SHIPSTATION_MOCK_API_KEY=SSAT_MOCK_KEY
SHIPSTATION_MOCK_WAREHOUSE_ID=se-28529731
SHIPSTATION_PILOT_AUTO_STATUS_SYNC=false
SHIPSTATION_PILOT_STATUS_POLL=false
SHIPSTATION_TRACKING_SYNC_ENABLED=false
SHIPSTATION_TRACKING_SYNC_SHADOW=true
SHIPSTATION_TRACKING_SYNC_UPDATE_FULFILLMENT=false
SHIPSTATION_TRACKING_DISPATCH_RECOVERY=false
SHIPSTATION_TRACKING_SYNC_QUEUE=
SHIPSTATION_TRACKING_SYNC_LOCK_SECONDS=120
SHIPSTATION_TRACKING_WEBHOOK_DEDUP_TTL=120

# PayPal (redirect checkout — webhooks not required)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use sandbox API when testing: https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
