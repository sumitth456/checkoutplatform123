# Copy to .env.production on the VPS, then merge values into .env.docker (or symlink).
# Never commit real secrets.

APP_NAME="Checkout Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=checkout_platform
DB_USERNAME=checkout
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=checkout_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp

PAYMENT_DEFAULT_PROVIDER=stripe
SUBSCRIPTION_SCHEDULER_FREQUENCY=hourly
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_VERIFY_SIGNATURE=true

# Laravel behind Cloudflare / reverse proxy
TRUSTED_PROXIES=*

RUN_MIGRATIONS=true
RUN_SEEDERS=false
STORAGE_LINK=true

WORKER_PROCESSES=2

TELESCOPE_ENABLED=false

APP_PORT=80
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=checkout_platform
MYSQL_USER=checkout
MYSQL_PASSWORD=
