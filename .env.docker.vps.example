# VPS template — IP-only (no domain). Copy to .env.docker on the server and set secrets.
# CloudPanel often uses port 80; default APP_PORT=8080 → http://YOUR_IP:8080
# If port 80 is free, set APP_PORT=80 and APP_URL=http://YOUR_IP

APP_NAME="Checkout Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://2.25.90.141:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=checkout_platform
DB_USERNAME=checkout
DB_PASSWORD=CHANGE_ME_STRONG

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=checkout_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_DEFAULT_PROVIDER=stripe
SUBSCRIPTION_SCHEDULER_FREQUENCY=hourly
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_VERIFY_SIGNATURE=false

TRUSTED_PROXIES=

RUN_MIGRATIONS=true
RUN_SEEDERS=false
STORAGE_LINK=true

WORKER_PROCESSES=2
TELESCOPE_ENABLED=false

APP_PORT=8080
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG
MYSQL_DATABASE=checkout_platform
MYSQL_USER=checkout
MYSQL_PASSWORD=CHANGE_ME_STRONG

# Do not publish DB/Redis on VPS (prod compose clears ports)
MYSQL_PORT=3306
REDIS_PORT=6379
