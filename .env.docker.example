# Copy to .env.docker and adjust secrets before running: cp .env.docker.example .env.docker

APP_NAME="Checkout Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=checkout_platform
DB_USERNAME=checkout
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=checkout_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

PAYMENT_DEFAULT_PROVIDER=stripe
SUBSCRIPTION_SCHEDULER_FREQUENCY=hourly
STRIPE_WEBHOOK_VERIFY_SIGNATURE=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RUN_MIGRATIONS=true
RUN_SEEDERS=false
STORAGE_LINK=true

WORKER_PROCESSES=2

# Compose service + MySQL bootstrap (used by docker compose --env-file .env.docker)
APP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=checkout_platform
MYSQL_USER=checkout
MYSQL_PASSWORD=secret